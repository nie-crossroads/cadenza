# 复制为 .env 后填写。不要提交 .env。

# HTTP 监听地址
CADENZA_ADDR=:8080

# 网页登录口令。登录成功后写入 HttpOnly Cookie，前端不读写。
CADENZA_WEB_PASSWORD=

# REST 与 MCP 共用的访问令牌。添加要带这个令牌。
# MCP 只从环境变量读取，不把令牌放进工具参数。
CADENZA_ACCESS_TOKEN=

# 站点走 HTTPS 时设为 true
CADENZA_COOKIE_SECURE=false

# 腾讯云 COS。公开域名要短，拼出的地址须放进博客 url(80) 与 cover(100)。
CADENZA_COS_SECRET_ID=
CADENZA_COS_SECRET_KEY=
CADENZA_COS_BUCKET=
CADENZA_COS_REGION=
CADENZA_COS_DOMAIN=

# 博客添加接口。只填站点源（例如 https://example.com）时，会补上
# /agent-blog/server/api/cadenza/music
CADENZA_BLOG_URL=
CADENZA_BLOG_TOKEN=

# 网易登录 Cookie，可选。不填时按当前可播放的音质试听和转存。
CADENZA_SOURCE_KEY=

# 可选，单位字节。默认音频 40MiB，封面 2MiB。
# CADENZA_MAX_AUDIO_BYTES=41943040
# CADENZA_MAX_COVER_BYTES=2097152
